SECRET_KEY=replace-this-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# PostgreSQL
DATABASE_URL=postgresql://kbc:kbc@127.0.0.1:5432/kbc

# Redis
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

SECURE_COOKIES=False
# Enable only after the site is permanently served over HTTPS.
SECURE_HSTS_SECONDS=31536000

# Optional: queue an ETA Celery task per question so answers lock exactly at
# the deadline. Requires a reachable broker; Celery beat still runs the
# one-second safety net when this is off.
CELERY_DEADLINE_TASKS=False
